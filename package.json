{
  "name": "chargeease-ev",
  "version": "1.0.0",
  "description": "ChargeEase EV - Reachability-First Peer-to-Peer EV Charging Platform",
  "main": "server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "mobile:prepare": "node scripts/prepare-android.mjs",
    "mobile:bundle-push": "esbuild mobile-push.js --bundle --format=iife --target=es2020 --outfile=mobile-push.bundle.js",
    "android:sync": "npm run mobile:prepare && cap sync android",
    "android:open": "npm run android:sync && cap open android",
    "android:init": "npm run mobile:prepare && cap add android",
    "mobile:bundle": "esbuild mobile-back-button.js --bundle --format=iife --target=es2020 --outfile=mobile-back-button.bundle.js"
  },
  "keywords": [
    "chargeease-ev",
    "ev-charging",
    "p2p-charging",
    "clean-tech",
    "electric-vehicle"
  ],
  "author": "ChargeEase EV",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.0.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3",
    "firebase-admin": "^14.5.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
